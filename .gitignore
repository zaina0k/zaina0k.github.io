# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables - everything .env-shaped except the blank template
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# credentials and keys - this repo and its host are public
*.pem
*.key
*.p12
id_rsa*
credentials*
secrets*

# Claude Code: worktrees and local settings
.claude/worktrees/
.claude/settings.local.json

# session handoffs stay local (may name in-progress work); the README is tracked
docs/handoffs/*
!docs/handoffs/README.md

# local planning material that lives in docs/ beside the tracked docs. Listed BY NAME so the
# tracked docs (overview, prd, architecture, ...) stay tracked and a new tracked doc is not
# silently ignored. Add a name here to keep a file local; do not ignore docs/ as a whole.
docs/portfolio-structural-plan.md
docs/design-language.md
docs/new-project-page-template.md
docs/project-blueprint-TEMPLATE.md
docs/project-blueprints/
docs/Downloadable CV.pdf
