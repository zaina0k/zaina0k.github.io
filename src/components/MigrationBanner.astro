---
// ╔══════════════════════════════════════════════════════════════════╗
// ║  REMOVABLE BANNER — delete when migration is complete            ║
// ║                                                                  ║
// ║  To remove this banner:                                          ║
// ║    1. Delete this file: src/components/MigrationBanner.astro     ║
// ║    2. Remove the import line in projects/index.astro:            ║
// ║         import MigrationBanner from                              ║
// ║           '../../components/MigrationBanner.astro';             ║
// ║    3. Remove the tag in projects/index.astro:                    ║
// ║         <MigrationBanner />                                      ║
// ║                                                                  ║
// ║  Target removal date: 13 July 2026                               ║
// ╚══════════════════════════════════════════════════════════════════╝
---

<div
  class="w-full border-b"
  style="background: var(--health-amber-bg); border-color: var(--health-amber-border);"
  role="banner"
>
  <div class="mx-auto max-w-5xl px-4 py-3 sm:px-6 sm:py-3.5">
    <div class="flex items-start gap-3">
      <div
        class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[6px]"
        style="background: var(--health-amber-bg); color: var(--health-amber); border: 1px solid var(--health-amber-border);"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
      </div>
      <div>
        <p class="font-bold text-[13px] leading-snug tracking-[-0.01em] text-[var(--text-primary)]">
          Projects migration in progress
        </p>
        <p class="mt-0.5 text-[12px] leading-relaxed text-[var(--text-secondary)]">
          I recently graduated with a 1st Class Honours BSc in Computer Science. University coursework projects and personal projects are currently being migrated to this portfolio. Migration is estimated to be complete by <strong class="font-semibold text-[var(--health-amber)]">13 July 2026</strong>.
        </p>
      </div>
    </div>
  </div>
</div>
