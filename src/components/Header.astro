---
import ThemeToggle from './ThemeToggle.tsx';

const navLinks = [
  { href: '/',           label: 'Home'     },
  { href: '/projects/',  label: 'Projects' },
  { href: '/about/',     label: 'About'    },
  { href: '/cv/',        label: 'CV'       },
  { href: '/contact/',   label: 'Contact'  },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-white/10"
  style="background: linear-gradient(135deg, #1e1e2e 0%, #2d2b55 50%, #4f46e5 100%); box-shadow: 0 2px 12px rgba(30, 30, 46, 0.15);"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3.5">
    <!-- Brand mark + name + subtitle (Template 4.2 Brand Header & 4.3 Top Bar) -->
    <a href="/" class="flex items-center gap-3 group">
      <span
        class="inline-flex items-center justify-center w-9 h-9 rounded-[10px] text-xs font-extrabold tracking-wider text-white shadow-md transition-transform duration-150 group-hover:-translate-y-px"
        style="background: linear-gradient(135deg, #4f46e5, #0891b2);"
      >
        ZA
      </span>
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="text-[16px] font-bold tracking-[-0.02em] text-white group-hover:text-white/90 transition-colors">
          Zain Altaf
        </span>
        <span class="text-[11px] font-normal text-white/60">
          CS Graduate · Software Engineer
        </span>
      </span>
    </a>

    <!-- Nav links + ThemeToggle + CTA (desktop) -->
    <div class="flex items-center gap-3">
      <ul class="hidden sm:flex items-center gap-1.5">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'inline-flex items-center px-3 py-1.5 rounded-[10px] text-[13px] transition-all duration-150',
                  isActive
                    ? 'bg-white/20 text-white font-semibold shadow-xs'
                    : 'text-[#cbd5e1] font-medium hover:bg-white/10 hover:text-white',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>

      <ThemeToggle client:load />

      <a
        href="/contact/"
        class="hidden sm:inline-flex items-center gap-2 rounded-[6px] px-3.5 py-1.5 text-[12px] font-semibold text-white bg-white/12 border border-white/25 hover:bg-white/22 hover:border-white/35 transition-all duration-150"
      >
        <span class="inline-block w-[7px] h-[7px] rounded-full bg-[#10b981] animate-pulse"></span>
        Get in touch →
      </a>

      <!-- Hamburger button (mobile only) -->
      <button
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="sm:hidden rounded-[6px] p-2 text-white/80 bg-white/10 border border-white/20 hover:text-white hover:bg-white/20 transition-all duration-150"
      >
        <!-- Hamburger icon -->
        <svg id="icon-open" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile nav drawer (Template 4.2 dark panel #1e1e2e) -->
  <div id="mobile-nav" class="hidden sm:hidden border-t border-white/10 bg-[#1e1e2e]">
    <ul class="flex flex-col px-6 py-4 gap-1.5">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2 rounded-[10px] text-[13px] transition-all duration-150',
                isActive
                  ? 'bg-[#4f46e5]/25 text-white font-semibold'
                  : 'text-[#cbd5e1] font-medium hover:bg-white/6 hover:text-white',
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
      <li class="pt-2">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-[6px] px-3.5 py-2 text-[12px] font-semibold text-white bg-[#4f46e5] hover:bg-[#4338ca] transition-all duration-150 shadow-sm"
        >
          <span class="inline-block w-[7px] h-[7px] rounded-full bg-[#10b981] animate-pulse"></span>
          Get in touch →
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var nav = document.getElementById('mobile-nav');
    var iconOpen = document.getElementById('icon-open');
    var iconClose = document.getElementById('icon-close');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var isOpen = !nav.classList.contains('hidden');
      if (isOpen) {
        nav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        nav.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>
