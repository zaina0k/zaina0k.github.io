---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div
  class="flex flex-col gap-1 rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--primary)] bg-[var(--bg-card)] px-4 py-3.5 transition-all duration-200 hover:-translate-y-px"
  style="box-shadow: var(--shadow-sm);"
>
  <span class="text-[10px] font-semibold tracking-[0.05em] uppercase text-[var(--text-secondary)]">{label}</span>
  <span class="text-[18px] font-extrabold leading-tight tracking-[-0.02em] text-[var(--text-primary)]">{value}</span>
</div>
