---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { UI_IMAGES } from '../lib/images';

interface Props {
  title: string;
  year: string;
  summary: string;
  tags: string[];
  href: string;
  thumbnail?: ImageMetadata;
}

const { title, year, summary, tags, href, thumbnail } = Astro.props;
const thumbnailAlt = `Screenshot of ${title}`;
---

<a
  href={href}
  class="group block rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--border-focus)] hover:-translate-y-0.5 transition-all duration-200 overflow-hidden"
  style="box-shadow: var(--shadow-sm);"
>
  <!-- Image area with title overlay -->
  <div class="relative aspect-video w-full overflow-hidden border-b border-[var(--border-color)]">
    {thumbnail ? (
      <Image
        src={thumbnail}
        alt={thumbnailAlt}
        width={800}
        height={450}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <img src={UI_IMAGES.inProgressThumbnail} alt="Project in progress" width={800} height={450} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
    )}

    <!-- Dark Blue / Indigo gradient banner behind title (Template section 9) -->
    <div
      class="absolute inset-x-0 bottom-0 px-4 py-3 z-10 flex items-center justify-between gap-2"
      style="background: linear-gradient(135deg, rgba(30, 30, 46, 0.94) 0%, rgba(45, 43, 85, 0.94) 50%, rgba(79, 70, 229, 0.94) 100%);"
    >
      <h3 class="text-[14px] font-bold tracking-[-0.01em] text-white leading-snug group-hover:text-white/90 transition-colors">
        {title}
      </h3>
      <span class="shrink-0 px-2 py-0.5 rounded-[20px] text-[10px] font-semibold bg-white/15 text-white/90">
        {year}
      </span>
    </div>
  </div>

  <!-- Below-image card body (Template 5.2 .card-body) -->
  <div class="p-4">
    <!-- Summary -->
    <p class="text-[13px] text-[var(--text-secondary)] leading-relaxed mb-4">{summary}</p>

    <!-- Tags (Template 5.5 .badge) -->
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold"
          style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
        >
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
