---
const rows = [
  {
    category: 'Languages',
    skills: ['Python', 'JavaScript', 'TypeScript', 'C++', 'SQL', 'HTML', 'CSS'],
  },
  {
    category: 'Frameworks',
    skills: ['Next.js', 'Flask', 'React', 'Unity'],
  },
  {
    category: 'Tools',
    skills: ['Git', 'GitHub', 'REST APIs', 'SQLite', 'VS Code'],
  },
  {
    category: 'Concepts',
    skills: ['Algorithms', 'Data Structures', 'API Design', 'Agile', 'TDD'],
  },
];
---

<section class="bg-[var(--bg-tertiary)] border-y border-[var(--border-color)]">
  <div class="mx-auto max-w-5xl px-6 py-16">

    <!-- Section header -->
    <div class="flex items-center gap-3 mb-8">
      <span
        class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold uppercase tracking-[0.05em]"
        style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
      >
        03 / Skills
      </span>
      <h2 class="text-2xl font-bold tracking-[-0.02em] text-[var(--text-primary)]">What I Work With</h2>
    </div>

    <!-- Card + Data Table Rows (Template 5.2 .card & 5.4 .data-table) -->
    <div
      class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] overflow-hidden"
      style="box-shadow: var(--shadow-sm);"
    >
      <div class="px-4 py-2.5 border-b border-[var(--border-color)] bg-[var(--bg-tertiary)] flex items-center justify-between">
        <span class="text-[10px] font-bold uppercase tracking-[0.05em] text-[var(--text-secondary)]">Category & Technologies</span>
        <span class="text-[10px] font-semibold uppercase tracking-[0.05em] text-[var(--text-muted)]">Core Stack</span>
      </div>
      <div class="flex flex-col divide-y divide-[var(--border-color)]">
        {rows.map(({ category, skills }) => (
          <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8 px-4 py-3.5 hover:bg-[var(--bg-hover)] transition-colors duration-150">
            <span class="w-28 shrink-0 text-[11px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)]">
              {category}
            </span>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[12px] font-semibold text-[var(--text-primary)] bg-[var(--bg-tertiary)] border border-[var(--border-color)]"
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
