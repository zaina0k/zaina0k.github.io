---
import { getCollection } from 'astro:content';
import { shortDateLabel, isOngoing } from '../lib/duration';

const allProjects = await getCollection('projects');
const projects = allProjects.sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime()
);
---

<div class="relative flex flex-col gap-0" aria-label="Projects timeline" role="list">
  <!-- Vertical rule: starts at first dot (top-2), continues past last dot (bottom-0) -->
  <div class="absolute left-[7px] top-2 bottom-2 w-px bg-[var(--border-color)]" aria-hidden="true"></div>

  {projects.map((p) => {
    const ongoing = isOngoing(p.data.endDate);
    return (
      <div class="relative flex gap-6 pb-8 last:pb-0 group" role="listitem">
        <div
          aria-hidden="true"
          class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--border-color)] bg-[var(--bg-card)] group-hover:border-[var(--primary)] group-hover:bg-[var(--primary)] transition-colors duration-200"
        ></div>
        <div>
          <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">
            {shortDateLabel(p.data.startDate)}{ongoing && ' — Ongoing'}
          </p>
          <div class="flex items-center gap-2.5 flex-wrap">
            <a
              href={`/projects/${p.id}/`}
              class="text-[14px] font-bold text-[var(--text-primary)] hover:text-[var(--primary)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] rounded-sm"
              aria-label={`${p.data.title} · ${shortDateLabel(p.data.startDate)}${ongoing ? ' — Ongoing' : ''} · ${p.data.status}`}
            >
              {p.data.title}
            </a>
            {p.data.status === 'shipped' && (
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-[20px] text-[10px] font-semibold"
                style="background: var(--health-green-bg); color: var(--health-green); border: 1px solid var(--health-green-border);"
              >
                Shipped
              </span>
            )}
            {p.data.status === 'in-progress' && (
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-[20px] text-[10px] font-semibold"
                style="background: var(--health-amber-bg); color: var(--health-amber); border: 1px solid var(--health-amber-border);"
              >
                In Progress
              </span>
            )}
            {p.data.status === 'planned' && (
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-[20px] text-[10px] font-semibold"
                style="background: var(--health-blue-bg); color: var(--health-blue); border: 1px solid var(--health-blue-border);"
              >
                Planned
              </span>
            )}
            {p.data.status === 'archived' && (
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-[20px] text-[10px] font-semibold"
                style="background: var(--health-gray-bg); color: var(--health-gray); border: 1px solid var(--health-gray-border);"
              >
                Archived
              </span>
            )}
          </div>
        </div>
      </div>
    );
  })}
</div>
