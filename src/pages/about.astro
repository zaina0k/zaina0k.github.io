---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FooterCTA from '../components/FooterCTA.astro';
import ProjectsTimeline from '../components/ProjectsTimeline.astro';
import profile2026 from '../assets/profile-2026.jpeg';

const skillRows = [
  { category: 'Languages',   skills: ['Python', 'JavaScript', 'TypeScript', 'C++', 'SQL', 'HTML', 'CSS'] },
  { category: 'Frameworks',  skills: ['Next.js', 'Flask', 'React', 'Unity'] },
  { category: 'Tools',       skills: ['Git', 'GitHub', 'REST APIs', 'SQLite', 'VS Code'] },
  { category: 'Concepts',    skills: ['Algorithms', 'Data Structures', 'API Design', 'Agile', 'TDD'] },
];
---

<BaseLayout title="About" description="About Zain Altaf — Computer Science graduate from the University of Leicester, building full-stack web applications.">
  <div class="mx-auto max-w-5xl px-6 py-20">

    <!-- Bio header: two-column on md+ (text left, photo right) -->
    <div class="flex flex-col md:flex-row md:items-start md:gap-16">

      <!-- Left: status, heading, bio -->
      <div class="flex-1">
        <!-- Status badge (Template 5.5 .badge-green) -->
        <div class="mb-7">
          <span
            class="inline-flex items-center gap-2 px-3 py-1 rounded-[20px] text-[11px] font-semibold tracking-wide uppercase"
            style="background: var(--health-green-bg); color: var(--health-green); border: 1px solid var(--health-green-border);"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--health-green)] animate-pulse"></span>
            CS Graduate · Open to opportunities
          </span>
        </div>

        <!-- Heading -->
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-[-0.03em] text-[var(--text-primary)] mb-8">
          Zain Altaf
        </h1>

        <!-- Bio paragraphs -->
        <div class="space-y-4 text-[14px] text-[var(--text-secondary)] leading-relaxed">
          <p>
            I'm a Computer Science graduate from the University of Leicester with nine years
            of programming experience and a particular focus on cloud systems, data analytics,
            and scalable architecture.
          </p>
          <p>
            I have worked with multiple languages (such as Python, Java, JS, SQL, and more)
            while utilising industry-standard tools and techniques to design, implement, and
            showcase a variety of projects. Relevant modules have given me an understanding of
            pivotal concepts such as REST API design, database and domain modelling, front-end
            UI design and integration, Agile software development methodologies, and more.
          </p>
          <p>
            Aligning the core ideas of these modules, my final-year dissertation put them into
            practice by designing a simulation engine to evaluate carbon-aware workload
            scheduling policies against real HPC trace data at scale.
          </p>
          <p>
            Professionally, I've worked in QA on a live production app serving thousands of
            users, and collaborated with IBM as Events Coordinator for the UoL Computer
            Science Society on technical events and a 100-person hackathon.
          </p>
          <p>
            What drives me is the conviction that well-engineered code is a durable asset —
            written with enough precision and structure today that it remains a reliable
            resource as requirements, scale, and circumstances inevitably shift. I'm drawn to
            architectures that anticipate future needs via redundancy or elastic compute models
            which make cloud systems resilient by design, as well as the predictive rigour that
            makes machine learning and big data projects genuinely useful at scale. I enjoy the
            artistic nature of balancing accurate and robust future-proof solutions while
            delivering fundamental features in the present that satisfy end-user requirements.
          </p>
        </div>
      </div>

      <!-- Right: profile photo (same photo as the home page, in light and dark) -->
      <div class="shrink-0 order-first md:order-last mb-8 md:mb-0">
        <div
          class="p-1.5 rounded-[16px] bg-[var(--bg-card)] border border-[var(--border-color)]"
          style="box-shadow: var(--shadow-lg);"
        >
          <Image
            src={profile2026}
            alt="Zain Altaf"
            width={512}
            height={512}
            densities={[1, 2, 3]}
            class="w-48 h-48 md:w-64 md:h-64 rounded-[12px] object-cover"
          />
        </div>
      </div>

    </div>

    <!-- Skills grid (Template 5.2 .card & 5.4 .data-table) -->
    <div class="mt-16">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold uppercase tracking-[0.05em]"
          style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
        >
          Skills
        </span>
        <h2 class="text-xl font-bold tracking-[-0.02em] text-[var(--text-primary)]">What I Work With</h2>
      </div>
      <div
        class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] overflow-hidden"
        style="box-shadow: var(--shadow-sm);"
      >
        <div class="flex flex-col divide-y divide-[var(--border-color)]">
          {skillRows.map(({ category, skills }) => (
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8 px-4 py-3.5 hover:bg-[var(--bg-hover)] transition-colors duration-150">
              <span class="w-28 shrink-0 text-[11px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)]">
                {category}
              </span>
              <div class="flex flex-wrap gap-2">
                {skills.map((skill) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[12px] font-semibold text-[var(--text-primary)] bg-[var(--bg-tertiary)] border border-[var(--border-color)]">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Project timeline -->
    <div class="mt-16">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold uppercase tracking-[0.05em]"
          style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
        >
          Projects
        </span>
        <h2 class="text-xl font-bold tracking-[-0.02em] text-[var(--text-primary)]">Project Timeline</h2>
      </div>
      <div
        class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] p-6"
        style="box-shadow: var(--shadow-sm);"
      >
        <ProjectsTimeline />
      </div>
    </div>

    <!-- Education + milestones timeline -->
    <div class="mt-16">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold uppercase tracking-[0.05em]"
          style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
        >
          Timeline
        </span>
        <h2 class="text-xl font-bold tracking-[-0.02em] text-[var(--text-primary)]">Education & Milestones</h2>
      </div>

      <div
        class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] p-6"
        style="box-shadow: var(--shadow-sm);"
      >
        <div class="relative flex flex-col gap-0">
          <!-- Vertical rule -->
          <div class="absolute left-[7px] top-2 bottom-2 w-px bg-[var(--border-color)]"></div>

          <!-- University of Leicester -->
          <div class="relative flex gap-6 pb-8">
            <div class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--primary)] bg-[var(--bg-card)]"></div>
            <div>
              <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">2022 – 2026</p>
              <h3 class="text-[15px] font-bold text-[var(--text-primary)]">University of Leicester</h3>
              <p class="text-[13px] text-[var(--text-secondary)] mt-0.5">BSc Computer Science — graduated 2026</p>
            </div>
          </div>

          <!-- Let's Hack Leicester -->
          <div class="relative flex gap-6 pb-8">
            <div class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--accent-cyan)] bg-[var(--bg-card)]"></div>
            <div>
              <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">2024</p>
              <h3 class="text-[15px] font-bold text-[var(--text-primary)]">Let's Hack Leicester</h3>
              <p class="text-[13px] text-[var(--text-secondary)] mt-0.5">
                Led a team of 5 to build a full-stack collaborative platform in 24 hours.
                Next.js, Flask, SQLite. Capital One–sponsored hackathon.
              </p>
            </div>
          </div>

          <!-- Morgan Stanley Coding Challenge -->
          <div class="relative flex gap-6 pb-8">
            <div class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--accent-cyan)] bg-[var(--bg-card)]"></div>
            <div>
              <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">2024</p>
              <h3 class="text-[15px] font-bold text-[var(--text-primary)]">Morgan Stanley Coding Challenge</h3>
              <p class="text-[13px] text-[var(--text-secondary)] mt-0.5">
                Built an EMA-based algorithmic trading bot. Placed 7th out of 27 teams.
              </p>
            </div>
          </div>

          <!-- Graduation -->
          <div class="relative flex gap-6 pb-8">
            <div class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--primary)] bg-[var(--bg-card)]"></div>
            <div>
              <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">2026</p>
              <h3 class="text-[15px] font-bold text-[var(--text-primary)]">Graduated</h3>
              <p class="text-[13px] text-[var(--text-secondary)] mt-0.5">
                BSc Computer Science, 1st Class Honours.
              </p>
            </div>
          </div>

          <!-- After graduation -->
          <div class="relative flex gap-6">
            <div class="mt-1.5 w-4 h-4 shrink-0 rounded-full border-2 border-[var(--primary)] bg-[var(--primary)]"></div>
            <div>
              <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">2026 – Present</p>
              <h3 class="text-[15px] font-bold text-[var(--text-primary)]">AI Integration Consultant</h3>
              <p class="text-[13px] text-[var(--text-secondary)] mt-0.5">DG Private Hire</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA + social links -->
    <div class="mt-16 pt-10 border-t border-[var(--border-color)]">
      <!-- Primary CTAs -->
      <div class="flex flex-wrap gap-3 mb-8">
        <a
          href="/cv/"
          download
          class="inline-flex items-center px-5 py-2.5 rounded-[6px] text-[13px] font-semibold bg-[var(--primary)] text-white hover:bg-[var(--primary-hover)] hover:-translate-y-px transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          Download CV ↗
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center px-5 py-2.5 rounded-[6px] text-[13px] font-semibold border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:bg-[var(--bg-hover)] hover:border-[var(--border-focus)] hover:text-[var(--primary)] transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          Get in touch →
        </a>
      </div>

      <!-- Social links -->
      <div class="flex flex-wrap items-center gap-6">
        <a
          href="mailto:dev@zainaltaf.com"
          class="inline-flex items-center gap-1 text-[13px] font-semibold text-[var(--primary)] hover:text-[var(--primary-hover)] transition-colors"
        >
          dev@zainaltaf.com →
        </a>
        <a
          href="https://www.linkedin.com/in/m-z-altaf/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href="https://github.com/zaina0k"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors"
        >
          GitHub ↗
        </a>
      </div>
    </div>

  </div>
  <FooterCTA />
</BaseLayout>
