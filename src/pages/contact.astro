---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
---

<BaseLayout title="Contact" description="Get in touch with Zain Altaf for software engineering opportunities and collaboration.">
  <div class="mx-auto max-w-5xl px-6 py-20">

    <div class="flex flex-col lg:flex-row lg:gap-20">

      <!-- Left column: intro text + fallback links -->
      <div class="lg:w-80 shrink-0 mb-12 lg:mb-0">
        <div class="mb-5">
          <span
            class="inline-flex items-center gap-2 px-3 py-1 rounded-[20px] text-[11px] font-semibold tracking-wide uppercase"
            style="background: var(--health-green-bg); color: var(--health-green); border: 1px solid var(--health-green-border);"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--health-green)] animate-pulse"></span>
            Available for Roles
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-[-0.03em] text-[var(--text-primary)] mb-5">
          Open to opportunities.<br />
          <span
            class="bg-clip-text text-transparent"
            style="background-image: linear-gradient(135deg, var(--primary), var(--accent-cyan));"
          >
            Let's connect.
          </span>
        </h1>

        <p class="text-[14px] text-[var(--text-secondary)] leading-relaxed mb-8">
          I'm looking for my first software engineering role and open to
          conversations about engineering, collaboration, and interesting
          problems. I read every message.
        </p>

        <!-- Fallback contact links (Template 5.2 .card) -->
        <div
          class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] p-4 flex flex-col gap-3"
          style="box-shadow: var(--shadow-sm);"
        >
          <span class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)]">
            Direct Channels
          </span>
          <a
            href="mailto:dev@zainaltaf.com"
            class="inline-flex items-center gap-2 text-[13px] font-semibold text-[var(--primary)] hover:text-[var(--primary-hover)] transition-colors"
          >
            dev@zainaltaf.com →
          </a>
          <a
            href="https://www.linkedin.com/in/m-z-altaf/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors"
          >
            LinkedIn ↗
          </a>
          <a
            href="https://github.com/zaina0k"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <!-- Right column: terminal contact form -->
      <div class="flex-1">
        <ContactForm client:visible />
      </div>

    </div>
  </div>
</BaseLayout>
