---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI_IMAGES } from '../lib/images';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="relative overflow-hidden mx-auto max-w-5xl px-6 py-24 text-center">
    <div
      class="mx-auto max-w-md rounded-[20px] border border-[var(--border-color)] bg-[var(--bg-card)] p-10"
      style="box-shadow: var(--shadow-lg);"
    >
      <img src={UI_IMAGES.errorPage} alt="" aria-hidden="true" width={320} height={320} class="w-40 h-auto mx-auto mb-6 opacity-85" />
      <span
        class="inline-flex items-center px-3 py-0.5 rounded-[20px] text-[11px] font-mono font-bold tracking-widest uppercase mb-4"
        style="background: var(--health-red-bg); color: var(--health-red); border: 1px solid var(--health-red-border);"
      >
        Error 404
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-[-0.03em] text-[var(--text-primary)] mb-3">
        Page not found.
      </h1>
      <p class="text-[var(--text-secondary)] text-[14px] mb-8 leading-relaxed">
        This URL doesn't exist on the new site. The projects index has everything worth finding.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-[var(--primary)] text-white text-[13px] font-semibold rounded-[6px] hover:bg-[var(--primary-hover)] hover:-translate-y-px transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          Go home
        </a>
        <a
          href="/projects/"
          class="inline-flex items-center justify-center px-5 py-2.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--text-primary)] text-[13px] font-semibold rounded-[6px] hover:bg-[var(--bg-hover)] hover:border-[var(--border-focus)] hover:text-[var(--primary)] transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          Browse projects
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
