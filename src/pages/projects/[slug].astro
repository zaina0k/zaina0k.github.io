---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FooterCTA from '../../components/FooterCTA.astro';
import { formatDateRange, formatDuration } from '../../lib/duration';
import MediaCarousel from '../../components/MediaCarousel';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const ogImage = data.ogImage ?? data.heroImage?.src ?? data.thumbnail?.src;
const carouselMedia = data.media?.length
  ? data.media
  : data.thumbnail
    ? [{ type: 'image' as const, src: data.thumbnail.src, alt: data.title }]
    : undefined;
---

<BaseLayout title={data.title} description={data.summary} ogImage={ogImage}>

  <!-- Hero area -->
  <div class="mx-auto max-w-4xl px-6 pt-16 pb-8">

    <!-- Category + year breadcrumb -->
    <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-5">
      <a href="/projects/" class="text-[var(--primary)] hover:underline transition-colors">← Projects</a>
      <span class="text-[var(--text-muted)]">/</span>
      <span
        class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] capitalize"
        style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
      >
        {data.category}
      </span>
      <span
        class="inline-flex items-center px-2.5 py-0.5 rounded-[20px]"
        style="background: var(--health-gray-bg); color: var(--health-gray); border: 1px solid var(--health-gray-border);"
      >
        {data.startDate!.getFullYear()}
      </span>
    </div>

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-[-0.02em] text-[var(--text-primary)] mb-3 leading-tight">
      {data.title}
    </h1>

    <!-- One-line summary -->
    <p class="text-[15px] text-[var(--text-secondary)] mb-8 max-w-2xl leading-relaxed">
      {data.summary}
    </p>

    <!-- Meta strip: KPI Grid (Template 5.3) -->
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
      <div
        class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--primary)] bg-[var(--bg-card)] px-3.5 py-3"
        style="box-shadow: var(--shadow-sm);"
      >
        <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Role</dt>
        <dd class="text-[13px] font-bold text-[var(--text-primary)]">{data.role}</dd>
      </div>
      {data.teamSize && (
        <div
          class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--accent-cyan)] bg-[var(--bg-card)] px-3.5 py-3"
          style="box-shadow: var(--shadow-sm);"
        >
          <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Team</dt>
          <dd class="text-[13px] font-bold text-[var(--text-primary)]">{data.teamSize} members</dd>
        </div>
      )}
      <div
        class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--primary)] bg-[var(--bg-card)] px-3.5 py-3"
        style="box-shadow: var(--shadow-sm);"
      >
        <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Period</dt>
        <dd class="text-[13px] font-bold text-[var(--text-primary)]">{formatDateRange(data.startDate!, data.endDate)}</dd>
      </div>
      <div
        class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--accent-cyan)] bg-[var(--bg-card)] px-3.5 py-3"
        style="box-shadow: var(--shadow-sm);"
      >
        <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Duration</dt>
        <dd class="text-[13px] font-bold text-[var(--text-primary)]">{formatDuration(data.startDate!, data.endDate)}</dd>
      </div>
      <div
        class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--health-green)] bg-[var(--bg-card)] px-3.5 py-3"
        style="box-shadow: var(--shadow-sm);"
      >
        <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Status</dt>
        <dd>
          {data.status === 'shipped' && (
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold"
              style="background: var(--health-green-bg); color: var(--health-green); border: 1px solid var(--health-green-border);"
            >
              Shipped
            </span>
          )}
          {data.status === 'in-progress' && (
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold"
              style="background: var(--health-amber-bg); color: var(--health-amber); border: 1px solid var(--health-amber-border);"
            >
              In Progress
            </span>
          )}
          {data.status === 'planned' && (
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold"
              style="background: var(--health-blue-bg); color: var(--health-blue); border: 1px solid var(--health-blue-border);"
            >
              Planned
            </span>
          )}
          {data.status === 'archived' && (
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-[20px] text-[11px] font-semibold"
              style="background: var(--health-gray-bg); color: var(--health-gray); border: 1px solid var(--health-gray-border);"
            >
              Archived
            </span>
          )}
        </dd>
      </div>
      <div
        class="rounded-[10px] border border-[var(--border-color)] border-t-2 border-t-[var(--primary)] bg-[var(--bg-card)] px-3.5 py-3"
        style="box-shadow: var(--shadow-sm);"
      >
        <dt class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-1">Category</dt>
        <dd class="text-[13px] font-bold text-[var(--text-primary)] capitalize">{data.category}</dd>
      </div>
    </dl>

    <!-- CTA links: GitHub + live demo (Template 5.1 .btn-secondary & .btn-primary) -->
    <div class="flex flex-wrap gap-3">
      {data.github && (
        <a
          href={data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] text-[13px] font-semibold text-[var(--text-primary)] hover:bg-[var(--bg-hover)] hover:border-[var(--border-focus)] hover:text-[var(--primary)] transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          GitHub ↗
        </a>
      )}
      {data.liveDemo && (
        <a
          href={data.liveDemo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[6px] bg-[var(--primary)] text-white text-[13px] font-semibold hover:bg-[var(--primary-hover)] hover:-translate-y-px transition-all duration-150"
          style="box-shadow: var(--shadow-sm);"
        >
          Live Demo ↗
        </a>
      )}
    </div>

  </div>

  <!-- Gallery (carousel) — shown when project has media entries -->
  {carouselMedia && (
    <div class="mx-auto max-w-4xl px-6 pb-8">
      <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-3">Gallery</p>
      <MediaCarousel media={carouselMedia} fallback={data.thumbnail?.src} client:visible />
    </div>
  )}

  <!-- Tech stack badges (Template 5.5 .badge) -->
  <div class="mx-auto max-w-4xl px-6 pb-8">
    <p class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--text-secondary)] mb-3">Tech Stack</p>
    <div class="flex flex-wrap gap-2">
      {data.techStack.map((tech) => (
        <span
          class="inline-flex items-center px-3 py-1 rounded-[20px] text-[11px] font-semibold"
          style="background: var(--primary-light); color: var(--primary); border: 1px solid var(--border-focus);"
        >
          {tech}
        </span>
      ))}
    </div>
  </div>

  <!-- Case study body (Template 5.2 .card) -->
  <div class="mx-auto max-w-4xl px-6 pb-8">
    <div
      class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-card)] p-6 sm:p-8"
      style="box-shadow: var(--shadow-sm);"
    >
      <article class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-[-0.02em] prose-headings:text-[var(--text-primary)] prose-p:text-[var(--text-secondary)] prose-p:leading-relaxed prose-li:text-[var(--text-secondary)] prose-a:text-[var(--primary)] hover:prose-a:text-[var(--primary-hover)] prose-code:font-mono prose-code:text-sm prose-pre:bg-[var(--bg-tertiary)] prose-pre:rounded-[10px] prose-pre:p-5 prose-pre:overflow-x-auto prose-blockquote:not-italic prose-blockquote:border-l-4 prose-blockquote:border-[var(--primary)] prose-blockquote:bg-[var(--bg-tertiary)] prose-blockquote:rounded-r-[10px] prose-blockquote:px-5 prose-blockquote:py-3 prose-blockquote:text-[var(--text-secondary)] prose-blockquote:text-sm">
        <Content />
      </article>
    </div>
  </div>

  <!-- In-progress / planned callout (Template 5.8 .flash) -->
  {(data.status === 'in-progress' || data.status === 'planned') && (
    <div class="mx-auto max-w-4xl px-6 pb-8">
      <div
        class="rounded-[6px] px-4 py-3 flex items-center gap-2.5"
        style="background: var(--health-amber-bg); color: var(--health-amber); border: 1px solid var(--health-amber-border);"
      >
        <p class="text-[13px] font-semibold">
          {data.status === 'in-progress' ? '🚧 This project is currently in progress — content may be incomplete.' : '📋 This project is planned and not yet started.'}
        </p>
      </div>
    </div>
  )}

  <!-- Results — shown for shipped projects only (Template 5.3 .kpi-card.health-green) -->
  {data.status === 'shipped' && data.results && data.results.length > 0 && (
    <div class="mx-auto max-w-4xl px-6 pb-8">
      <div
        class="rounded-[10px] bg-[var(--bg-card)] border border-[var(--border-color)] border-t-2 border-t-[var(--health-green)] p-6"
        style="box-shadow: var(--shadow-sm);"
      >
        <h2 class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--health-green)] mb-4">Key Results</h2>
        <ul class="space-y-2.5">
          {data.results.map((item) => (
            <li class="flex items-start gap-2.5 text-[13px] font-semibold text-[var(--text-primary)]">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--health-green)]" />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- Reflection — shown for shipped and archived projects -->
  {(data.status === 'shipped' || data.status === 'archived') && data.reflection && (
    <div class="mx-auto max-w-4xl px-6 pb-8">
      <div
        class="rounded-[10px] bg-[var(--bg-card)] border border-[var(--border-color)] border-l-4 border-l-[var(--primary)] p-6"
        style="box-shadow: var(--shadow-sm);"
      >
        <h2 class="text-[10px] font-bold tracking-[0.05em] uppercase text-[var(--primary)] mb-3">Reflection</h2>
        {data.reflection.split('\n\n').map((para) => (
          <p class="text-[13px] text-[var(--text-secondary)] leading-relaxed mb-4 last:mb-0">{para}</p>
        ))}
      </div>
    </div>
  )}

  <!-- Back nav -->
  <div class="mx-auto max-w-4xl px-6 pb-10 border-t border-[var(--border-color)] pt-6">
    <a
      href="/projects/"
      class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[6px] border border-[var(--border-color)] bg-[var(--bg-card)] text-[13px] font-semibold text-[var(--text-primary)] hover:bg-[var(--bg-hover)] hover:border-[var(--border-focus)] hover:text-[var(--primary)] transition-all duration-150"
      style="box-shadow: var(--shadow-sm);"
    >
      ← All projects
    </a>
  </div>

  <FooterCTA />

</BaseLayout>
